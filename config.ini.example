[openitcockpit]
# Copy this file to config.ini and fill in real values.
# config.ini is gitignored and must never be committed.
#
# Alternatively, all of these can be set as environment variables instead
# (OITC_APIKEY, OITC_BASEURL, OITC_ENABLE_WRITE_TOOLS,
# OITC_SCOPE_CACHE_ENABLED, OITC_SCOPE_CACHE_TTL_SECONDS) - environment
# variables always take precedence over config.ini.

api_key = your-api-key-here
base_url = https://your-openitcockpit-instance/

# Write tools (e.g. CreateHost) are disabled by default. Set to "true" to
# enable them. Only do this if you understand the tool will make real
# changes to the monitoring configuration.
enable_write_tools = false

# Write tools validate that referenced objects (host templates, contacts,
# timeperiods, ...) are visible from the target container's scope before
# writing, by calling the same "allowed elements" endpoints the web UI uses.
# Those responses are cached briefly per scope to avoid one extra API round
# trip per validated field on every write call. Set to "false" to disable
# caching entirely (always fetch fresh); the cache is also cleared after
# every successful write.
scope_cache_enabled = true
scope_cache_ttl_seconds = 30
