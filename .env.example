# Copy to .env and fill in real values. .env is gitignored and must never be
# committed. Every value here can also be passed as a real environment
# variable, which takes precedence over .env.
#
# docker-compose.yml reads this file automatically (env_file: .env).

# --- Credentials -----------------------------------------------------------
# TWO SEPARATE SECRETS. Do not reuse one for the other - the server refuses to
# start if they are identical.

# 1) The bearer token MCP *clients* must present to THIS server.
#    Clients send it as:  Authorization: Bearer <MCP_AUTH_TOKEN>
#    Generate one with:
#      python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=change-me-generate-a-random-token

# 2) The API key THIS server presents to openITCOCKPIT. Create it for a
#    dedicated, least-privilege openITCOCKPIT user - every MCP client that
#    passes the bearer check acts with that user's permissions.
OITC_APIKEY=your-openitcockpit-api-key
OITC_BASEURL=https://your-openitcockpit-instance

# --- Connection to openITCOCKPIT -------------------------------------------
# Certificate verification is ON by default. For a self-signed instance point
# OITC_CA_BUNDLE at the CA certificate instead of turning verification off.
OITC_VERIFY_TLS=true
#OITC_CA_BUNDLE=/etc/ssl/certs/my-openitcockpit-ca.pem
OITC_TIMEOUT_SECONDS=20

# --- Tool surface ----------------------------------------------------------
# Write tools make real changes to the monitoring configuration and are not
# even registered as MCP tools unless this is true.
OITC_ENABLE_WRITE_TOOLS=false

# Write tools validate referenced objects (host templates, contacts,
# timeperiods, ...) against the target container's scope before writing. Those
# lookups are cached briefly to avoid one extra API round trip per field.
OITC_SCOPE_CACHE_ENABLED=true
OITC_SCOPE_CACHE_TTL_SECONDS=30

# Halves every response by replacing the text half of a tool result with a
# one-line summary. Only clients that read structuredContent (MCP revision
# 2025-06-18 or later) still see the data afterwards. Leave this off for
# clients that read content only - Open WebUI, for instance.
OITC_COMPACT_CONTENT=false

# --- Transport -------------------------------------------------------------
# http  = network server, requires MCP_AUTH_TOKEN (default)
# stdio = spawned by a local client over stdin/stdout, no bearer token needed
OITC_TRANSPORT=http
OITC_HOST=0.0.0.0
# docker-compose.yml publishes this same port, so changing it here moves both
# the container's listener and the host mapping.
OITC_PORT=8000
OITC_LOG_LEVEL=INFO

# The start-up banner goes to stderr. Turn it off where a log collector
# would rather not parse a picture.
OITC_SHOW_BANNER=true
